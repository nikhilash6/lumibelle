@inherits ProjectAwareComponent
@using lumibelle.Services.Production
@using lumibelle.Services.Shots
@using lumibelle.Components.AI
@inject IProjectDubbingStore Dubs
@inject IProjectStore Projects
@inject IShotStore Shots
@inject IAiJobStore JobStore
@inject AiJobCoordinator Jobs
@inject AiTextJobCapture TextRequests
@inject AiVideoJobCapture VideoRequests
@implements IAsyncDisposable

<PageTitle>Language versions · Lumibelle</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(_dirty || _busy || Pending is not null)" OnBeforeInternalNavigation="BeforeNavigation" />
<EditSessionRegistration Save="SaveForClose" />
@if (_project is not null)
{
    <ProjectNavigation Project="_project" CurrentStudio="shots" />
    <StudioPageHeader Title="Language versions"><a href="@ProjectLink(Id, "/shots")">Back to Shots</a><a href="@ProjectLink(Id, "/settings")">Configure languages</a></StudioPageHeader>
    <div class="dubbing-studio">
        <p>Keep the master script and rendered take unchanged. Translate its spoken dialogue, review it, then render a separate language version using the same captured images, reels, voices, crops, duration, model settings and seed.</p>
        <p class="field-hint"><strong>This renders new video and audio, not an audio-only dub of the existing frames.</strong> Identical references do not guarantee identical motion, lip sync, voice accent or timing. Visual directions remain in the master prompt's wording.</p>
        @if (_languages?.Main is null || _languages.Dubs.Count == 0)
        { <p role="status">Set the master language and at least one dub language in Project settings.</p> }
        else
        {
            <div class="dub-selectors">
                <label>Rendered master take<select value="@_takeId" @onchange="SelectTake" disabled="@Locked">
                    <option value="">Choose a master take</option>
                    @foreach (var take in MasterTakes) { <option value="@take.Id">@take.Snapshot.Shot.Title · @TakeDisplay.Label(take)</option> }
                </select></label>
                <label>Dub language<select value="@_target" @onchange="SelectLanguage" disabled="@Locked">
                    @foreach (var language in _languages.Dubs) { <option value="@language.Code">@language.Name (@language.Code)</option> }
                </select></label>
                <button disabled="@Locked" @onclick="Reload">Refresh saved takes</button>
            </div>
            @if (MasterTakes.Count == 0) { <p>Render a master take with dialogue in Shots first.</p> }
            @if (_request is { } request)
            {
                <p class="dub-source-summary">Master: @request.Main.Name → @request.Target.Name · @request.Duration.ToString("0.###") seconds · frozen take @(request.SourceTakeId.ToString()[..8])</p>
                <section aria-label="Translation assistance" class="dub-assistance">
                    <TextModelPicker ProjectId="Id" Studio="TextAssistantStudio.Production" Disabled="@(_busy || Pending is not null)" SelectionChanged="state => _model = state" />
                    <label>Instructions for this translation<textarea rows="3" maxlength="12000" @bind="_instructions" @bind:event="oninput" disabled="@(_busy || Pending is not null)"></textarea></label>
                    <MudButton OnClick="Translate" Disabled="@(_busy || _dirty || Pending is not null || _model?.Ready != true || ActiveTranslation is not null)" Color="Color.Primary" Variant="Variant.Filled"><AiAssistIcon />Suggest translated dialogue</MudButton>
                    <p class="field-hint">Text-only assistance: no images, video, audio or RefMods are sent to the translating model. Review meaning and timing before saving.</p>
                </section>
                @if (ActiveTranslation is { } otherTranslation && otherTranslation.Id != _translationJobId)
                { <p role="status">Another translation of this master take is active. Open it from AI activity or wait for it to finish.</p> }
                @if (TranslationJob is { } translationJob)
                {
                    <AiJobProgressView Job="translationJob" Queue="Jobs.View" Progress="Jobs.Progress(translationJob.Id)" />
                    @if (translationJob.LocksTarget) { <button disabled="@_busy" @onclick="() => Cancel(translationJob.Id)">Cancel translation</button> }
                    @if (_rawResult is not null) { <details><summary>Inspect translation response</summary><pre tabindex="0">@_rawResult.Raw</pre>@if (_rawResult.Error is not null) { <p role="alert">@_rawResult.Error</p> }</details> }
                    @if (_suggestion is not null && _suggestionRequest is not null)
                    {
                        <section class="dub-suggestion" aria-label="Translation suggestion"><h2>Suggested dialogue</h2>
                            @for (var i = 0; i < _suggestion.Lines.Count; i++) { <p dir="auto"><strong>@_suggestionRequest.Dialogue[i].Speaker:</strong> @_suggestion.Lines[i].Text</p> }
                            @foreach (var note in _suggestion.Notes) { <p class="field-hint">@note</p> }
                            <button disabled="@(_dirty || _busy)" @onclick="UseSuggestion">Use suggestion in editor</button>
                        </section>
                    }
                }
                <section aria-label="Dub dialogue editor"><h2>@request.Target.Name dialogue</h2>
                    @for (var i = 0; i < request.Dialogue.Count; i++)
                    {
                        var index = i; var line = request.Dialogue[i];
                        <div class="dub-dialogue-row" @key="line.Id">
                            <div><strong>@(i + 1). @line.Speaker</strong><small> @line.Language · source</small><p dir="auto">@line.Text</p></div>
                            <label>@request.Target.Name<textarea rows="3" dir="auto" value="@_lines[index].Text" @oninput="e => EditLine(index, e.Value?.ToString() ?? string.Empty)" disabled="@_busy"></textarea></label>
                        </div>
                    }
                    <div class="dub-actions"><MudButton OnClick="SaveClick" Disabled="@(_busy || !_dirty || PreviewIssue is not null)" Color="Color.Primary" Variant="Variant.Filled">Save language version</MudButton><button disabled="@_busy" @onclick="Discard">Discard edits</button><span role="status">@(_dirty ? "Unsaved dialogue" : _saved is null ? "No saved translation" : "Saved language version " + _saved.Version)</span></div>
                    @if (PreviewIssue is { } issue) { <p class="field-hint">@issue</p> }
                    @foreach (var note in _notes) { <p class="field-hint">@note</p> }
                    <details><summary>Language prompt · only dialogue and language labels changed</summary><pre tabindex="0">@Preview</pre></details>
                </section>
                <section aria-label="Render language version" class="dub-render">
                    <h2>Render language take</h2>
                    <p>Uses the master take's captured input files, not the current asset library. Missing captured files stop the request rather than substituting different references.</p>
                    <MudButton OnClick="RenderDub" Disabled="@(_busy || _dirty || _saved is null || Pending is not null || ActiveVideo is not null)" Variant="Variant.Filled" Color="Color.Primary">Render @request.Target.Name take</MudButton>
                    @if (_renderError is not null) { <p role="alert" class="field-error">@_renderError</p> }
                    @if (ActiveVideo is { } video) { <AiJobProgressView Job="video" Queue="Jobs.View" Progress="Jobs.Progress(video.Id)" /><button @onclick="() => Cancel(video.Id)">Cancel video request</button> }
                    @if (_renderJobId is { } render && Jobs.View.Jobs.FirstOrDefault(j => j.Id == render) is { Error: not null } failed) { <p role="alert">@failed.Error</p> }
                </section>
                <section aria-label="Rendered dub takes"><h2>Rendered language takes</h2>
                    @foreach (var take in DubTakes)
                    {
                        <article class="dub-take" @key="take.Id"><strong>@TakeDisplay.Label(take)</strong><span> · language version @take.Snapshot.Dub!.VariantVersion</span><a href="@ProjectLink(Id, $"/shots?shotId={take.ShotId}&view=Takes")">Review in Shots</a></article>
                    }
                    @if (DubTakes.Count == 0) { <p>No saved takes for this language and master take yet.</p> }
                    <p class="field-hint">Use the Language filter in Shots or Cut's latest-take chooser. Master latest-take selection excludes dubs.</p>
                </section>
            }
        }
        @if (Pending is not null) { <p role="alert">Queue acknowledgement is missing. Retry this exact captured request; do not start another one.</p><button disabled="@_busy" @onclick="RetryEnqueue">Retry saving request</button> }
        @if (_error is not null) { <p role="alert" class="field-error">@_error</p> }
        @if (_notice is not null) { <p role="status">@_notice</p> }
    </div>
}
else { <p role="status">@(_error ?? "Opening language versions…")</p> }
