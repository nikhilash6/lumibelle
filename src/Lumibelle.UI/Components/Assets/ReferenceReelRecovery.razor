@inject IProjectStore Projects
@inject IAssetStore AssetsStore
@inject IAssetReelStore Reels

<section aria-label="Reference reel recovery">
    <h2>Reference reels</h2>
    <p>Removed reels remain recoverable. Their media stays available to attached shots and captured requests.</p>
    <button disabled="@_busy" @onclick="Load">Refresh reels</button>
    @if (_error is not null) { <p role="alert">@_error</p> }
    @foreach (var row in _rows) {
        <article class="reel-recovery-row" @key="row.Item.Reel.Id">
            <span>@row.Project.Name · @row.Item.Owner.Name · @row.Item.Reel.Name</span>
            <button disabled="@_busy" @onclick="() => Restore(row.Project.Id, row.Item.Reel.Id)">Restore reel</button>
        </article>
    }
</section>
@code {
    private readonly List<(ProjectInfo Project, TrashedReferenceReel Item)> _rows = [];
    private string? _error;
    private bool _busy;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() {
        _busy = true; _error = null; _rows.Clear();
        try { foreach (var project in (await Projects.ListAsync()).Projects) {
            try { var library = await AssetsStore.LoadAsync(project.Id); _rows.AddRange(library.ReelTrash.Select(t => (project, t))); }
            catch (WorkspaceStoreException e) { _error = $"{project.Name}: {e.Message}"; }
        } } finally { _busy = false; }
    }
    private async Task Restore(Guid project, Guid reel) {
        _busy = true; _error = null;
        try { var library = await AssetsStore.LoadAsync(project); await Reels.RestoreReelAsync(project, reel, library.Revision); await Load(); }
        catch (WorkspaceStoreException e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
