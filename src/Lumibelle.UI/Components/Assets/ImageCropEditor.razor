@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="image-copy-crop">
    <p class="field-hint">@Hint</p>
    <div class="crop-stage" inert="@Disabled" data-max-zoom="@MaxZoom" style="@FormattableString.Invariant($"aspect-ratio:{Width}/{Height};--source-ratio:{Width / (double)Height}")" @ref="_stage">
        <img src="@Url" alt="@($"Source image for {SelectionLabel.ToLowerInvariant()}")" />
        <span class="crop-selection" style="@Style" data-x="@N(Region.X)" data-y="@N(Region.Y)" data-width="@N(Region.Width)" data-height="@N(Region.Height)" data-zoom="@N(_zoom)" aria-hidden="true">
            <i class="crop-handle top" data-crop-handle="top"></i><i class="crop-handle right" data-crop-handle="right"></i><i class="crop-handle bottom" data-crop-handle="bottom"></i><i class="crop-handle left" data-crop-handle="left"></i>
        </span>
    </div>
    <label>@SelectionLabel shape<select disabled="@Disabled" @bind="_aspect" @bind:after="Changed"><option>Original</option>@if (_initialRatio is not null) { <option value="Custom">@(SelectionLabel == "Crop" ? "Current crop" : "Current selection")</option> }<option>1:1</option><option>4:3</option><option>3:4</option><option>16:9</option><option>9:16</option></select></label>
    <details><summary>Precise @SelectionLabel.ToLowerInvariant() controls</summary><div class="crop-controls">
        <label>Zoom<input disabled="@Disabled" aria-label="@($"{SelectionLabel} zoom")" type="range" min="1" max="@MaxZoom" step="0.01" @bind="_zoom" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:after="Changed" /></label>
        <label>Horizontal position<input disabled="@Disabled" aria-label="@($"{SelectionLabel} horizontal position")" type="range" min="0" max="100" step="1" @bind="_x" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:after="Changed" /></label>
        <label>Vertical position<input disabled="@Disabled" aria-label="@($"{SelectionLabel} vertical position")" type="range" min="0" max="100" step="1" @bind="_y" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:after="Changed" /></label>
    </div></details>
    <div class="crop-size"><button disabled="@Disabled" type="button" @onclick="Reset">Full image</button><span class="field-hint">@Pixels.Width × @Pixels.Height pixels</span></div>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MaxZoom { get; set; } = 4;
    [Parameter] public string SelectionLabel { get; set; } = "Crop";
    [Parameter] public string Hint { get; set; } = "Drag the selection to position it, or use the shape and precise controls. The original image stays unchanged.";
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public int Width { get; set; }
    [Parameter] public int Height { get; set; }
    [Parameter] public EventCallback<ImageCropRegion> CropChanged { get; set; }
    [Parameter] public ImageCropRegion? InitialCrop { get; set; }
    private double? _initialRatio;
    protected override void OnInitialized()
    {
        if (InitialCrop is not { } crop) return;
        var source = Width / (double)Height;
        _initialRatio = source * crop.Width / crop.Height; _aspect = "Custom";
        var maxWidth = _initialRatio >= source ? 1 : _initialRatio.Value / source;
        _zoom = maxWidth / crop.Width;
        _x = crop.Width >= 1 ? 50 : crop.X / (1 - crop.Width) * 100;
        _y = crop.Height >= 1 ? 50 : crop.Y / (1 - crop.Height) * 100;
    }
    private ElementReference _stage; private IJSObjectReference? _module; private DotNetObjectReference<ImageCropEditor>? _reference;
    private string _aspect = "Original"; private double _zoom = 1, _x = 50, _y = 50; private bool _disposed;
    private ImageCropRegion Region
    {
        get
        {
            var source = Width / (double)Height;
            var parts = _aspect.Split(':');
            var target = parts.Length == 2 ? double.Parse(parts[0]) / double.Parse(parts[1]) : _aspect == "Custom" ? _initialRatio ?? source : source;
            var w = (target >= source ? 1 : target / source) / _zoom;
            var h = (target >= source ? source / target : 1) / _zoom;
            return new() { X = (1 - w) * _x / 100, Y = (1 - h) * _y / 100, Width = w, Height = h };
        }
    }
    private SixLabors.ImageSharp.Rectangle Pixels => ImageGeometry.CropPixels(Width, Height, Region);
    private string Style => FormattableString.Invariant($"left:{Region.X * 100}%;top:{Region.Y * 100}%;width:{Region.Width * 100}%;height:{Region.Height * 100}%");
    private static string N(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("assets-studio.js"));
        if (_disposed) { await _module.DisposeAsync(); return; }
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachCropGestures", _stage, _reference);
    }
    private Task Changed() => CropChanged.InvokeAsync(Region);
    private Task Reset() { _initialRatio = null; _aspect = "Original"; _zoom = 1; _x = _y = 50; return Changed(); }
    [JSInvokable] public async Task ApplyCropGesture(double zoom, double x, double y)
    { if (_disposed || Disabled) return; _zoom = Math.Clamp(zoom, 1, MaxZoom); _x = Math.Clamp(x, 0, 100); _y = Math.Clamp(y, 0, 100); await Changed(); await InvokeAsync(StateHasChanged); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_module is not null) { await _module.InvokeVoidAsync("detachCropGestures", _stage); await _module.DisposeAsync(); } } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
