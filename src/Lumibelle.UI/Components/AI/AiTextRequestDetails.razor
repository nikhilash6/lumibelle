@inject IAiJobStore Store
@inject IServiceProvider Services
<details class="request-details"><summary @onclick="LoadAsync">Request details</summary>
    @if (_request is { } request) {
        <p>@request.Model.Backend · @request.Model.Name · @(request.SelectionSource switch { TextModelSelectionSource.GlobalDefault => "Global default", TextModelSelectionSource.ProjectDefault => "Project default", TextModelSelectionSource.RequestOverride => "Request override", _ => "Captured model" })</p>
        @if (request.Repair is { } repair) {
            <p>Text-only validation repair · source request <code>@repair.SourceJobId</code>. No reference media was resent.</p>
            <details><summary>Failed response and repair contract</summary><pre>@repair.FailedResponse</pre><p>@repair.ValidationError</p><pre>@repair.Contract.GetRawText()</pre></details>
        }
        @if (request.Model.ProfileId is not null) {
            <p>LLM profile snapshot · @request.Model.Name · <code>@request.Model.Model</code></p>
        }
        @if (request.Model.ProfileId is not null || request.Model.ReasoningEffort is not null || request.Model.Temperature is not null || request.Model.MaxOutputTokens is not null || request.Model.ReasoningMaxTokens is not null) {
            <p>Requested settings · @TextModelProfiles.Describe(request.Model)</p>
        }
        <pre class="submitted-input">@string.Join("\n\n", request.Messages.Select(m => m.Role + ":\n" + string.Join("\n", m.Parts.Select(p => p.Text ?? "[Attached image]"))))</pre>
    } else { <p>@(_error ?? "Loading captured input…")</p> }
</details>
@if (Services.GetService(typeof(IAiTextRepairService)) is IAiTextRepairService)
{
    <AiTextRepairAction @key="JobId" JobId="JobId" ReviewRequested="RepairReviewRequested" />
}
@code {
    [Parameter] public Guid JobId { get; set; }
    [Parameter] public EventCallback<AiJobHeader> RepairReviewRequested { get; set; }
    private Guid? _loaded;
    private AiTextJobRequest? _request;
    private string? _error;
    protected override void OnParametersSet() { if (_loaded != JobId) { _request = null; _error = null; } }
    private async Task LoadAsync() {
        if (_loaded == JobId) return;
        var id = JobId;
        try {
            var job = (await Store.ReadAsync()).Jobs.FirstOrDefault(j => j.Id == id);
            if (job is null) throw new WorkspaceStoreException("The captured request is unavailable.");
            var request = AiTextJobHandler.Read(job, await Store.ReadSnapshotAsync(id));
            if (JobId == id) { _request = request; _loaded = id; _error = null; }
        } catch (WorkspaceStoreException e) { _error = e.Message; }
    }
}
