@inject IServiceProvider Services
@implements IAsyncDisposable
<span @ref="_marker" aria-hidden="true" class="ai-result-observer"></span>
@if (_error is not null) { <p class="field-error" role="status">@_error</p> }
@code {
    [Parameter] public IReadOnlyList<AiJobHeader> Observed { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<Guid, Guid[]>? MediaByJob { get; set; }
    private ElementReference _marker;
    private IJSObjectReference? _module;
    private readonly CancellationTokenSource _life = new();
    private bool _checking;
    private string? _error;
    private readonly HashSet<(Guid, long)> _acknowledged = [];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await AcknowledgeAsync();
        if (firstRender) _ = ObserveAsync();
    }
    private async Task ObserveAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Services.GetService<TimeProvider>() ?? TimeProvider.System);
            while (await timer.WaitForNextTickAsync(_life.Token)) await InvokeAsync(AcknowledgeAsync);
        }
        catch (OperationCanceledException) { }
    }
    private async Task AcknowledgeAsync()
    {
        if (_checking || _life.IsCancellationRequested || !Observed.Any(j => j.Unread && !_acknowledged.Contains((j.Id, j.Version))) || Services.GetService<AiJobCoordinator>() is not { } jobs) return;
        _checking = true;
        try
        {
            var observed = Observed.Where(j => j.Unread && !_acknowledged.Contains((j.Id, j.Version))).ToArray();
            _module ??= await Services.GetRequiredService<IJSRuntime>().InvokeAsync<IJSObjectReference>("import", lumibelle.UiAssets.Module("ai-jobs.js"));
            if (!await _module.InvokeAsync<bool>("isReviewVisible", _marker)) return;
            if (MediaByJob is { } media)
            {
                var ready = new List<AiJobHeader>();
                foreach (var job in observed)
                    if (media.TryGetValue(job.Id, out var ids) && (ids.Length > 0
                        ? await _module.InvokeAsync<bool>("areReviewMediaReady", _marker, ids)
                        : job.Error is not null)) ready.Add(job);
                observed = ready.ToArray();
                if (observed.Length == 0) return;
            }
            await jobs.ChangeActivityAsync(observed, AiActivityChange.Read, _life.Token);
            foreach (var job in observed) _acknowledged.Add((job.Id, job.Version));
            if (_error is not null) { _error = null; StateHasChanged(); }
        }
        catch (OperationCanceledException) { }
        catch (JSException) { }
        catch (WorkspaceStoreException) { _error = "Unable to mark this result read. Retrying while its review is open."; StateHasChanged(); }
        finally { _checking = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _life.Cancel();
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        _life.Dispose();
    }
}
