@inject IServiceProvider Services
<form class="settings-card" @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <div class="settings-card-title"><span class="provider-badge">LOCAL CLI</span><h2>Claude Code</h2></div>
    <p>Use your installed Claude Code CLI for text assistance, with the account it's set up with. A Claude plan sign-in counts toward that plan's usage limits; an API key, organization or cloud-provider setup is billed to that account.</p>
    <label class="check-row"><input type="checkbox" @bind="_enabled" disabled="@(Busy || _checking)" />Enable Claude Code</label>
    <label for="claudecode-executable">Executable path (optional)</label><input id="claudecode-executable" @bind="_path" placeholder="Detect installed claude automatically" disabled="@(Busy || _checking)" />
    <label for="claudecode-concurrency">Concurrent requests</label><input id="claudecode-concurrency" type="number" min="1" max="4" step="1" @bind="_concurrency" disabled="@(Busy || _checking)" />
    <MudButton OnClick="CheckAsync" Disabled="@(Busy || _checking || !_enabled)" Variant="Variant.Outlined">Check connection</MudButton>
    @if (_checking) { <p role="status">Checking the CLI and its account setup…</p> }
    @if (_check is { } check)
    {
        <p role="status">@check.Message</p>
        @if (check.Success)
        {
            <dl><dt>CLI version</dt><dd>@check.Version</dd><dt>API provider</dt><dd>@ProviderLabel(check.ApiProvider)</dd>
                <dt>Signed-in account</dt><dd>@(check.AccountLabel ?? "Not reported")</dd>@if (check.AuthMethod is { } method) { <dt>Sign-in method</dt><dd>@method</dd> }</dl>
        }
    }
    <CliInstallHint Name="Claude Code" WindowsCommand="irm https://claude.ai/install.ps1 | iex" UnixCommand="curl -fsSL https://claude.ai/install.sh | bash" Guide="https://code.claude.com/docs/en/setup">
        <Alternatives>Or use <code>@(OperatingSystem.IsWindows() ? "winget install Anthropic.ClaudeCode" : "brew install --cask claude-code")</code> or <code>npm install -g @("@")anthropic-ai/claude-code</code>.</Alternatives>
        <SignIn>Then open a new terminal, run <code>claude</code> once and sign in. Claude Code needs a Pro, Max, Team, Enterprise or Console account, or a cloud provider such as Amazon Bedrock set up for it.</SignIn>
    </CliInstallHint>
    <p class="field-hint">Requires CLI @ClaudeCodeClient.MinimumVersion or later. Set up and sign in with <code>claude</code> in a terminal outside Lumibelle; requests use the same setup, including its environment variables. Lumibelle never reads or stores your credentials, and each request runs without tools, integrations or saved sessions. Claude Code does not report remaining usage to other apps; if a usage or rate limit ends a request, the queue pauses until you resume it. <a href="https://code.claude.com/docs/en/authentication" target="_blank" rel="noopener noreferrer">Sign-in instructions</a></p>
    <div class="settings-section-actions"><MudButton ButtonType="ButtonType.Submit" Disabled="@(Busy || _checking)" Color="Color.Primary" Variant="Variant.Filled">Save Claude Code connection</MudButton><MudButton OnClick="Reset" Disabled="@(Busy || _checking)">Cancel</MudButton></div>
</form>
@code {
    [Parameter] public ClaudeCodeSettings Settings { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public Func<ClaudeCodeSettings, Task<bool>> SaveSettings { get; set; } = null!;
    private bool _enabled, _checking, _initialized;
    private int _concurrency = 1;
    private string _path = "";
    private ClaudeCodeConnection? _check;
    private static string ProviderLabel(string? provider) => provider switch
    {
        null or "firstParty" => "Anthropic", "bedrock" => "Amazon Bedrock", "vertex" => "Google Cloud",
        "foundry" => "Microsoft Foundry", _ => provider
    };
    protected override void OnParametersSet() { if (!_initialized) { Reset(); _initialized = true; } }
    private ClaudeCodeSettings Draft => Settings with { Enabled = _enabled, ExecutablePath = _path.Trim(), Concurrency = _concurrency };
    private void Reset() { _enabled = Settings.Enabled; _path = Settings.ExecutablePath; _concurrency = Settings.Concurrency; }
    private async Task SaveAsync() { if (!Busy && !_checking && await SaveSettings(Draft)) Reset(); }
    private async Task CheckAsync()
    {
        _checking = true;
        try { _check = await Services.GetRequiredService<IClaudeCodeClient>().CheckAsync(Draft); }
        catch (Exception e) when (e is AiGenerationException or InvalidOperationException) { _check = new(false, e.Message, "", null, null, []); }
        finally { _checking = false; }
    }
}
