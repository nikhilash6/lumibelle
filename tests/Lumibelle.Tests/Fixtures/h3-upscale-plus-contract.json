  "MinimaxH3LatentUpscaler3D": {
    "output": [
      "*"
    ],
    "output_is_list": [
      false
    ],
    "input": {
      "required": {
        "latent": [
          "*",
          {
            "tooltip": "Input latent (image or video)."
          }
        ],
        "model_name": [
          "COMBO",
          {
            "tooltip": "Minimax H3 upscale model.",
            "multiselect": false,
            "options": [
              "minimax_h3_latent_upscaler_3d_bf16.safetensors",
              "minimax_h3_latent_upscaler_3d_fp16.safetensors"
            ]
          }
        ],
        "mode": [
          "COMFY_DYNAMICCOMBO_V3",
          {
            "tooltip": "How the target size is computed.",
            "options": [
              {
                "key": "scale by multiplier",
                "inputs": {
                  "required": {
                    "scale": [
                      "FLOAT",
                      {
                        "tooltip": "Upscale factor.",
                        "default": 2.0,
                        "min": 1.0,
                        "max": 4.0,
                        "step": 0.05
                      }
                    ]
                  }
                }
              },
              {
                "key": "target dimensions",
                "inputs": {
                  "required": {
                    "width": [
                      "INT",
                      {
                        "tooltip": "Target pixel width.",
                        "default": 1280,
                        "min": 64,
                        "max": 4096,
                        "step": 8
                      }
                    ],
                    "height": [
                      "INT",
                      {
                        "tooltip": "Target pixel height.",
                        "default": 704,
                        "min": 64,
                        "max": 4096,
                        "step": 8
                      }
                    ]
                  }
                }
              },
              {
                "key": "megapixels",
                "inputs": {
                  "required": {
                    "megapixels": [
                      "FLOAT",
                      {
                        "tooltip": "Target megapixels (1024x1024 = 1MP).",
                        "default": 1.0,
                        "min": 0.1,
                        "max": 8.0,
                        "step": 0.1
                      }
                    ]
                  }
                }
              }
            ]
          }
        ],
        "align": [
          "INT",
          {
            "tooltip": "Pixel-space alignment. Both output axes are placed on a grid compatible with this value and the H3 16x VAE grid.",
            "default": 32,
            "min": 1,
            "max": 512,
            "step": 1
          }
        ],
        "keep_proportion": [
          "BOOLEAN",
          {
            "tooltip": "Preserve the source aspect ratio as closely as the requested alignment grid allows.",
            "default": true
          }
        ],
        "device": [
          "COMBO",
          {
            "default": "cuda",
            "multiselect": false,
            "options": [
              "cuda",
              "cpu"
            ]
          }
        ],
        "precision": [
          "COMBO",
          {
            "default": "fp16",
            "multiselect": false,
            "options": [
              "fp32",
              "fp16",
              "bf16"
            ]
          }
        ],
        "offload_after_upscale": [
          "BOOLEAN",
          {
            "tooltip": "Move the cached learned upscaler to CPU after inference to free VRAM. Leave off for faster repeated runs when VRAM is available.",
            "default": false
          }
        ]
      }
    }
  }
}
